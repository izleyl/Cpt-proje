@inherits LayoutComponentBase

<div class="page">
    <main>
        <article class="content">
            @Body
        </article>
    </main>
</div>

<style>
    
    body, html {
        margin: 0;
        padding: 0;
        background-color: #0d1117; 
        color: #c9d1d9;
        font-family: 'Inter', system-ui, sans-serif;
    }

    
    .page {
        display: flex;
        flex-direction: column;
        min-height: 100vh;
    }

    main {
        flex: 1;
        display: flex;
        flex-direction: column;
    }

    .content {
        flex: 1;
        display: flex;
        flex-direction: column;
    }

   
    #blazor-error-ui {
        background: #21262d;
        color: #ff7b72;
        bottom: 0;
        box-shadow: 0 -1px 2px rgba(0,0,0,0.2);
        display: none;
        left: 0;
        padding: 0.6rem 1.25rem;
        position: fixed;
        width: 100%;
        z-index: 1000;
    }
</style>